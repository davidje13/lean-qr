{
  "name": "lean-qr",
  "version": "2.7.3",
  "description": "minimal QR code generation",
  "private": true,
  "bin": "./cli.mjs",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./nano": {
      "types": "./index.d.ts",
      "default": "./nano.mjs"
    },
    "./extras/svg": {
      "types": "./index.d.ts",
      "default": "./extras/svg.mjs"
    },
    "./extras/node_export": {
      "types": "./index.d.ts",
      "default": "./extras/node_export.mjs"
    },
    "./extras/png": {
      "types": "./index.d.ts",
      "default": "./extras/png.mjs"
    },
    "./extras/react": {
      "types": "./index.d.ts",
      "default": "./extras/react.mjs"
    },
    "./extras/vue": {
      "types": "./index.d.ts",
      "default": "./extras/vue.mjs"
    },
    "./webcomponent": {
      "types": "./webcomponent.d.ts",
      "default": "./webcomponent.mjs"
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "start": "BUILD_FILTER=web-frontend web-listener -c web/config.json --dir web/build/static --exec 'rollup --config rollup.config.mjs --watch' --no-cache",
    "build-web": "./tools/build.sh && web-listener ./web/build/static --write-compressed --brotli --no-serve && cd web/build && zip -8Xr -n .br:.png - * > ../../web-bundle.zip",
    "test": "lean-test --target=node,chrome,firefox -x '**/*.node.*' -x '**/*.browser.*' && lean-test -i '**/*.node.test.*' && TEST=true lean-test --target=chrome,firefox --preprocess=rollup -i '**/*.browser.test.*' && TEST=true NO_MINIFY=true lean-test --target=chrome,firefox --preprocess=rollup -i '**/*.browser.raw.test.*' && ./test-package/run.sh && prettier --check .",
    "dopublish": "./tools/build.sh && npm publish package.tgz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidje13/lean-qr.git"
  },
  "keywords": [
    "qr",
    "qr-code",
    "qrcode",
    "barcode",
    "react",
    "react-component",
    "preact",
    "preact-component",
    "vue",
    "vue-component",
    "web-component",
    "console",
    "terminal"
  ],
  "author": "David Evans",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/davidje13/lean-qr/issues"
  },
  "homepage": "https://github.com/davidje13/lean-qr#readme",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.x",
    "@rollup/plugin-terser": "1.x",
    "@vue/runtime-dom": "3.x",
    "lean-test": "2.x",
    "pngjs": "7.x",
    "preact": "10.x",
    "prettier": "3.6.2",
    "rollup": "4.x",
    "web-listener": "1.4.x"
  }
}
